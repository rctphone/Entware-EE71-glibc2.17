#!/bin/sh
### BEGIN INIT INFO
# Provides:		sshd
# Required-Start:	$remote_fs $syslog $networking
# Required-Stop:	$remote_fs $syslog
# Default-Start:	2 3 4 5
# Default-Stop:		1
# Short-Description:	Dropbear Secure Shell server
### END INIT INFO
#
# Do not configure this file. Edit /etc/default/dropbear instead!
#

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/sbin/dropbear
NAME=dropbear
DESC="Dropbear SSH server"

DROPBEAR_PORT=22
DROPBEAR_EXTRA_ARGS=
NO_START=0

# Refuse password logins (dropbear -s); key auth only. Set to 0 in
# /etc/default/dropbear to allow passwords again — do that BEFORE
# restarting dropbear, or you lock yourself out if you have no key.
DROPBEAR_DISABLE_PASSWORD_AUTH=1

# Key types to generate/use (ed25519 preferred, rsa as fallback)
DROPBEAR_KEYTYPES="ed25519 rsa"

# Host key directory
DROPBEAR_KEYDIR="/etc/dropbear"

# Interfaces on which to allow SSH traffic via iptables
ALLOW_SSH_INTERFACES="bridge0 ecm0 wlan0"

set -e

test ! -r /etc/default/dropbear || . /etc/default/dropbear
test "$NO_START" = "0" || exit 0
test -x "$DAEMON" || exit 0
test ! -h /var/service/dropbear || exit 0

# Handle read-only rootfs
readonly_rootfs=0
for flag in $(awk '{ if ($2 == "/") { split($4,FLAGS,",") } }; END { for (f in FLAGS) print FLAGS[f] }' </proc/mounts); do
  case $flag in
    ro) readonly_rootfs=1 ;;
  esac
done

if [ "$readonly_rootfs" = "1" ]; then
  DROPBEAR_KEYDIR="/var/lib/dropbear"
  mkdir -p "$DROPBEAR_KEYDIR"
fi

gen_keys() {
  for ktype in $DROPBEAR_KEYTYPES; do
    kfile="${DROPBEAR_KEYDIR}/dropbear_${ktype}_host_key"
    if [ ! -f "$kfile" ]; then
      echo "Generating $ktype host key..."
      dropbearkey -t "$ktype" -f "$kfile" >/dev/null 2>&1 || {
        echo "Warning: failed to generate $ktype key"
        rm -f "$kfile"
      }
    fi
  done
}

get_pw_args() {
  # An `[ cond ] && assign` here would return 1 when cond is false, and `set -e`
  # would abort the script before start-stop-daemon runs — so setting
  # DROPBEAR_DISABLE_PASSWORD_AUTH=0 would stop dropbear from starting at all,
  # and on `restart` would kill the running daemon without replacing it.
  # An if-condition is exempt from set -e.
  PW_ARGS=""
  if [ "$DROPBEAR_DISABLE_PASSWORD_AUTH" = "1" ]; then
    PW_ARGS="-s"
  fi
}

get_key_args() {
  KEY_ARGS=""
  for ktype in $DROPBEAR_KEYTYPES; do
    kfile="${DROPBEAR_KEYDIR}/dropbear_${ktype}_host_key"
    test -f "$kfile" && KEY_ARGS="$KEY_ARGS -r $kfile"
  done
}

# IPv4 only. SSH over IPv6 is closed solely by /etc/init.d/ip6tables_firewall
# (S38), whose INPUT policy is DROP with no tcp/22 accept — dropbear listens on
# :::22 and this function adds no v6 defence of its own. If that script is ever
# relaxed or stopped (its `stop` case does `-P INPUT ACCEPT; -F INPUT`), SSH
# becomes reachable over IPv6 from the WAN with nothing here to stop it.
fw_open() {
  # Idempotent: a restart used to call fw_open without fw_close and duplicate
  # every rule below.
  fw_close

  # Established traffic. Insert first so these end up BELOW the SYN rules.
  for IFACE in $ALLOW_SSH_INTERFACES; do
    iptables -I INPUT -i "$IFACE" -p tcp --dport "$DROPBEAR_PORT" -j ACCEPT 2>/dev/null || true
  done

  # Catch-all for new connections. Inserted before the per-interface accepts
  # below, so it ends up underneath them and only sees SYN packets that
  # arrived on an interface not in ALLOW_SSH_INTERFACES — i.e. the WAN.
  iptables -I INPUT -p tcp --dport "$DROPBEAR_PORT" --syn -j DROP 2>/dev/null || true

  # DHEat DoS mitigation (CVE-2002-20001): rate-limit new SSH SYN packets,
  # burst 5 then 10/minute, PER LAN INTERFACE.
  # This rule used to have no -i, which put an unconditional ACCEPT for port 22
  # above the DROP: SSH answered on the carrier-facing rmnet_data0 with
  # password auth enabled and a root password set. Keep the -i.
  for IFACE in $ALLOW_SSH_INTERFACES; do
    iptables -I INPUT -i "$IFACE" -p tcp --dport "$DROPBEAR_PORT" --syn \
      -m limit --limit 10/minute --limit-burst 5 -j ACCEPT 2>/dev/null || true
  done
}

fw_close() {
  for IFACE in $ALLOW_SSH_INTERFACES; do
    while iptables -D INPUT -i "$IFACE" -p tcp --dport "$DROPBEAR_PORT" -j ACCEPT 2>/dev/null; do :; done
  done
  # Rate-limiting rules, current per-interface form
  for IFACE in $ALLOW_SSH_INTERFACES; do
    while iptables -D INPUT -i "$IFACE" -p tcp --dport "$DROPBEAR_PORT" --syn \
      -m limit --limit 10/minute --limit-burst 5 -j ACCEPT 2>/dev/null; do :; done
  done
  # ...and the pre-2026.91-2 unbound form, so upgrading over a running daemon
  # does not leave the WAN-facing ACCEPT behind.
  while iptables -D INPUT -p tcp --dport "$DROPBEAR_PORT" --syn \
    -m limit --limit 10/minute --limit-burst 5 -j ACCEPT 2>/dev/null; do :; done
  while iptables -D INPUT -p tcp --dport "$DROPBEAR_PORT" --syn -j DROP 2>/dev/null; do :; done
}

case "$1" in
  start)
	echo -n "Starting $DESC: "
	gen_keys
	fw_open
	get_key_args
	get_pw_args
	start-stop-daemon -S -x "$DAEMON" -- \
	  $KEY_ARGS -p "$DROPBEAR_PORT" $PW_ARGS $DROPBEAR_EXTRA_ARGS
	echo "$NAME."
	;;
  stop)
	echo -n "Stopping $DESC: "
	fw_close
	start-stop-daemon -K -x "$DAEMON"
	echo "$NAME."
	;;
  restart|force-reload)
	echo -n "Restarting $DESC: "
	start-stop-daemon -K -x "$DAEMON"
	sleep 1
	gen_keys
	fw_open
	get_key_args
	get_pw_args
	start-stop-daemon -S -x "$DAEMON" -- \
	  $KEY_ARGS -p "$DROPBEAR_PORT" $PW_ARGS $DROPBEAR_EXTRA_ARGS
	echo "$NAME."
	;;
  status)
	if start-stop-daemon -K -t -x "$DAEMON" >/dev/null 2>&1; then
	  echo "$NAME is running."
	else
	  echo "$NAME is not running."
	  exit 1
	fi
	;;
  *)
	echo "Usage: /etc/init.d/$NAME {start|stop|restart|status}" >&2
	exit 1
	;;
esac

exit 0
