# EE71 Entware config — minimal, expanded by 'make defconfig'
# Target: ARMv7-A Cortex-A7, softfp + NEON VFPv4, glibc 2.17, kernel 3.10
# Requires Entware ee71 branch with custom armv7-3.10 target

# --- Target ---
CONFIG_TARGET_armv7_3_10=y
CONFIG_TARGET_armv7_3_10_Default=y

# --- Target tuning (must be explicit — defconfig defaults are wrong) ---
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mtune=cortex-a7 -mfloat-abi=softfp -mfpu=neon-vfpv4"
# CONFIG_SOFT_FLOAT is not set

# --- Toolchain ---
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_13=y
CONFIG_GLIBC_USE_VERSION_2_17=y
CONFIG_BINUTILS_USE_VERSION_2_34=y

# --- Build options ---
CONFIG_USE_LTO=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_IMAGEOPT=y
CONFIG_IPV6=y
# CONFIG_SIGNED_PACKAGES is not set

# --- Feeds (rctphone only) ---
CONFIG_FEED_rctphone=y
# CONFIG_FEED_packages is not set
# CONFIG_FEED_routing is not set
# CONFIG_FEED_telephony is not set

# --- Security: disable hardening (embedded target, size matters) ---
CONFIG_PKG_ASLR_PIE_NONE=y
CONFIG_PKG_CC_STACKPROTECTOR_NONE=y
CONFIG_PKG_FORTIFY_SOURCE_NONE=y
CONFIG_PKG_RELRO_NONE=y

# --- Core Entware packages (from base tree) ---
CONFIG_PACKAGE_entware-opt=y
CONFIG_PACKAGE_entware-release=y
CONFIG_PACKAGE_entware-upgrade=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libssp=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_locales=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnetfilter-conntrack=y

# --- Base tree packages (customized for EE71) ---
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_openssl-util=y

# --- OpenSSL features (matched to device libcrypto.so.1.1 build) ---
# Compiler: -DOPENSSL_SMALL_FOOTPRINT -DOPENSSL_PREFER_CHACHA_OVER_GCM -DOPENSSL_API_COMPAT=0x00907000L
# Full ARM assembly (AES, SHA, GHASH, POLY1305, ECP, BSAES)
# CONFIG_OPENSSL_WITH_DEPRECATED is not set
# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set
CONFIG_OPENSSL_WITH_DTLS=y
CONFIG_OPENSSL_WITH_NPN=y
CONFIG_OPENSSL_WITH_EC2M=y
CONFIG_OPENSSL_WITH_ASYNC=y
CONFIG_OPENSSL_WITH_ARIA=y
CONFIG_OPENSSL_WITH_CAMELLIA=y
CONFIG_OPENSSL_WITH_IDEA=y
CONFIG_OPENSSL_WITH_SEED=y
CONFIG_OPENSSL_WITH_SM234=y
CONFIG_OPENSSL_WITH_BLAKE2=y
CONFIG_OPENSSL_WITH_MDC2=y
CONFIG_OPENSSL_WITH_WHIRLPOOL=y
CONFIG_OPENSSL_WITH_COMPRESSION=y
CONFIG_OPENSSL_WITH_RFC3779=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_libnl=y
CONFIG_PACKAGE_libxml2=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_broken_rtc=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_hostapd=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wpa-cli=y
# CONFIG_PACKAGE_ppp is not set
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_busybox=y

# --- rctphone feed (packages not in base tree) ---
CONFIG_PACKAGE_sqlite3=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_miniupnpd=y
# CONFIG_PACKAGE_miniupnpd-nftables is not set
CONFIG_PACKAGE_shadowsocks-libev=y
CONFIG_PACKAGE_jq=y

# --- rctphone feed: ee71 ---
CONFIG_PACKAGE_ee71-webui=y
CONFIG_PACKAGE_ee71-traffic-stats=y
CONFIG_PACKAGE_ee71-sms-forward=y
CONFIG_PACKAGE_ee71-internetometer=y
CONFIG_PACKAGE_ee71-speedtest-cli=y
CONFIG_PACKAGE_ee71-qcmap-fix=y
CONFIG_PACKAGE_ee71-core-app-wifi-fix=y
CONFIG_PACKAGE_ee71-ttl-fix=y
CONFIG_PACKAGE_ee71-ipv6=y
CONFIG_PACKAGE_ee71-optimize=y
CONFIG_PACKAGE_ee71-webs-csp=y
CONFIG_PACKAGE_ee71-kmod-amneziawg=y
CONFIG_PACKAGE_ee71-kmod-tun=y
CONFIG_PACKAGE_ee71-kmod-wireguard=y
# Modules come pre-built from docker/kernel-modules/build.sh into files/.
# Only has an effect once the VPN tunnel itself carries IPv6 — see
# docs/plans/ipv6-nat-feasibility.md
CONFIG_PACKAGE_ee71-kmod-nat66=y
# The WiFi driver rebuilt from qcacld-2.0 source. Shipping it is inert:
# installing the package does not switch drivers, only
# `/etc/init.d/ee71-wlan-rebuilt enable` does.
CONFIG_PACKAGE_ee71-kmod-wlan=y
CONFIG_PACKAGE_ee71-apn-ru=y
CONFIG_PACKAGE_ee71-usb-adb=y

# --- EE71-specific ---
CONFIG_PACKAGE_strace=y
