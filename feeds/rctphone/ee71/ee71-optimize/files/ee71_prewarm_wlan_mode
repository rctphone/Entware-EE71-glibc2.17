#!/bin/sh
# ee71_prewarm_wlan_mode — set WlanMode in XML BEFORE QCMAP starts
#
# Problem: QCMAP serializes its in-memory config back to /etc/mobileap_cfg.xml
# at various points. The default WlanMode in the binary's hardcoded defaults
# is "AP", so after any cold boot the XML reverts from AP-AP to AP.
#
# Fix: Before QCMAP is launched (in rcS.d, runs BEFORE S39start_QCMAP),
# check the DB user intent and write the matching WlanMode directly to XML.
# QCMAP will parse this correctly on startup and initialize wlan1 for dual-band.

DB="/jrd-resource/resource/sqlite3/user_info.db3"
XML="/etc/mobileap_cfg.xml"
FACTORY_XML="/etc/factory_mobileap_cfg.xml"
LOG="/tmp/ee71_prewarm_wlan.log"
HEALTH="/tmp/ee71_wifi_health"

log() { echo "[$(date '+%F %H:%M:%S')] $*" >> "$LOG"; }
health_err() {
    echo "[$(date '+%F %H:%M:%S')] prewarm:$*" >> "$HEALTH"
    logger -t ee71_prewarm "ERROR: $*" 2>/dev/null
}

[ -f "$DB" ] || { log "DB not found, skip"; exit 0; }
[ -f "$XML" ] || { log "XML not found, skip"; exit 0; }

# Wait briefly for DB and filesystems to settle (we're in rcS.d, very early)
i=0
while [ $i -lt 10 ]; do
    # Make sure DB is readable
    sqlite3 "$DB" "SELECT 1 FROM wifi_info LIMIT 1;" >/dev/null 2>&1 && break
    sleep 1
    i=$((i+1))
done

# Read user intent
AP2G=$(sqlite3 "$DB" "SELECT value FROM wifi_info WHERE items='2GAPStatus';" 2>/dev/null)
AP5G=$(sqlite3 "$DB" "SELECT value FROM wifi_info WHERE items='5GAPStatus';" 2>/dev/null)
GUEST5G=$(sqlite3 "$DB" "SELECT value FROM wifi_info WHERE items='Guest5GAPStatus';" 2>/dev/null)

log "DB: 2GAPStatus=$AP2G 5GAPStatus=$AP5G Guest5GAPStatus=$GUEST5G"

# Determine desired WlanMode:
#   AP-AP: 2GAPStatus=1 AND Guest5GAPStatus=1 (our dual-band convention)
#   AP:    anything else
DESIRED="AP"
if [ "$AP2G" = "1" ] && [ "$GUEST5G" = "1" ]; then
    DESIRED="AP-AP"
fi

log "Desired WlanMode: $DESIRED"

# Patch runtime XML (and factory for persistence across QCMAP regen).
# Verify the sed actually applied — if not, XML may be malformed or missing the tag.
for f in "$XML" "$FACTORY_XML"; do
    [ -f "$f" ] || continue
    CUR=$(grep -o '<WlanMode>[^<]*</WlanMode>' "$f" | sed 's|<[^>]*>||g')
    if [ -z "$CUR" ]; then
        health_err "$f missing <WlanMode> tag (XML malformed or wrong schema)"
        log "ERROR: $f has no <WlanMode> tag, skip"
        continue
    fi
    if [ "$CUR" = "$DESIRED" ]; then
        log "$f already $DESIRED"
        continue
    fi
    sed -i "s|<WlanMode>[^<]*</WlanMode>|<WlanMode>$DESIRED</WlanMode>|" "$f"
    # Verify the replacement actually landed
    NEW=$(grep -o '<WlanMode>[^<]*</WlanMode>' "$f" | sed 's|<[^>]*>||g')
    if [ "$NEW" = "$DESIRED" ]; then
        log "Patched $f: $CUR → $DESIRED (verified)"
    else
        health_err "$f sed failed: expected $DESIRED, got '$NEW'"
        log "ERROR: $f sed did not apply ($CUR → $NEW, expected $DESIRED)"
    fi
done

sync
exit 0
