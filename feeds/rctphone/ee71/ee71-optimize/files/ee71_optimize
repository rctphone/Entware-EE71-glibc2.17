#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_optimize
# Required-Start:    $remote_fs
# Default-Start:     2 3 4 5
# Short-Description: EE71 performance optimization (full suite)
### END INIT INFO

# Performance optimizations — all phases from optimization design doc.
# Results: +398% page cache, 196MB tmpfs freed, 6 services removed, ~10MB RAM saved

LAN_RULE="-i bridge0 -j ACCEPT"

# ============================================================
# Phase 1: oem_watch cleanup (applied by separate oem_watch_patch)
# Phase 1: init scripts (applied by disable_* below)
# ============================================================

do_disable_init_scripts() {
    # Disable init scripts by prefixing DISABLED_ (reversible)
    for script in \
        /etc/rcS.d/S07bootlogd \
        /etc/rc5.d/S20hwclock.sh \
        /etc/rc5.d/S91start_alx_le \
        /etc/rc5.d/S70start_eMBMs_TunnelingModule_le \
        /etc/rc5.d/S90start_subsystem_ramdump \
        /etc/rc5.d/S99stop-bootlogd \
        /etc/rc5.d/S98dbus-1 \
    ; do
        if [ -e "$script" ] && [ "$(basename "$script")" = "${script##*/}" ]; then
            dir=$(dirname "$script")
            base=$(basename "$script")
            if [ "${base#DISABLED_}" = "$base" ]; then
                mv "$script" "${dir}/DISABLED_${base}" 2>/dev/null && \
                    echo "optimize: disabled $base" || true
            fi
        fi
    done
}

do_misc_daemon_timeout() {
    # Reduce misc-daemon modem wait timeout from 10s to 3s
    MISC="/etc/init.d/misc-daemon"
    if [ -f "$MISC" ] && grep -q "counter} -le 10" "$MISC" 2>/dev/null; then
        cp -n "$MISC" "${MISC}.old" 2>/dev/null
        sed -i 's/counter} -le 10/counter} -le 3/' "$MISC"
        echo "optimize: misc-daemon modem timeout reduced to 3s"
    fi
}

# ============================================================
# Phase 2: Service cleanup
# ============================================================

do_tmpfs() {
    # Right-size tmpfs mounts.
    # Stock: 67.9+67.9+67.9 = 203.7MB reserved (168KB actually used)
    # Current device: /run=4m, /var/volatile=48m, /media/ram=48m = 100MB total
    #
    # Real usage on device:
    #   /run: 36KB (pid files, sockets, utmp)
    #   /var/volatile: 116KB (/var/tmp → volatile/tmp, GoAhead CGI tempfiles)
    #   /media/ram: 0 (always empty)
    mount -o remount,size=4m /run 2>/dev/null && echo "optimize: /run → 4m" || true
    mount -o remount,size=48m /var/volatile 2>/dev/null && echo "optimize: /var/volatile → 48m" || true
    mount -o remount,size=48m /media/ram 2>/dev/null && echo "optimize: /media/ram → 48m" || true

    # Clean up stale GoAhead CGI temp files (webs creates cgi* in /var/tmp
    # for each request and never removes them — accumulates thousands)
    find /var/volatile/tmp -name 'cgi*' -mmin +60 -delete 2>/dev/null || true

    # Install optimized fstab for persistence across reboots
    if [ -f /etc/fstab.optimized ] && ! grep -q "size=4m" /etc/fstab 2>/dev/null; then
        cp -n /etc/fstab /etc/fstab.old 2>/dev/null
        cp /etc/fstab.optimized /etc/fstab
        echo "optimize: fstab updated (persistent)"
    fi
}

do_getty() {
    # Comment out getty in inittab
    if grep -q "^S:.*respawn:/sbin/getty" /etc/inittab 2>/dev/null; then
        cp -n /etc/inittab /etc/inittab.old 2>/dev/null
        sed -i 's|^S:.*respawn:/sbin/getty|#PERF: disabled serial console\n#&|' /etc/inittab
        killall getty 2>/dev/null || true
        echo "optimize: getty disabled"
    fi
}

do_nbnsd() {
    # Rename nbnsd binary to prevent QCMAP from restarting it
    if [ -f /usr/bin/nbnsd ]; then
        mv /usr/bin/nbnsd /usr/bin/nbnsd.disabled
        killall nbnsd 2>/dev/null || true
        echo "optimize: nbnsd disabled"
    fi
}

# ============================================================
# Phase 2: Filesystem
# ============================================================

do_noatime() {
    # Remount all UBIFS with noatime (20-30% write savings)
    mount -o remount,noatime,bulk_read / 2>/dev/null && echo "optimize: / noatime" || true
    mount -o remount,noatime,bulk_read /usr 2>/dev/null || true
    mount -o remount,noatime,bulk_read /jrd-resource 2>/dev/null || true
    mount -o remount,noatime,bulk_read /cache 2>/dev/null || true
    mount -o remount,noatime,bulk_read /recovery 2>/dev/null || true

    # Patch find_partitions.sh for persistence (adds noatime to UBI mounts)
    FP="/etc/init.d/find_partitions.sh"
    if [ -f "$FP" ] && grep -q 'bulk_read"$' "$FP" 2>/dev/null; then
        cp -n "$FP" "${FP}.old" 2>/dev/null
        sed -i 's/bulk_read"/bulk_read,noatime"/' "$FP" 2>/dev/null && \
            echo "optimize: find_partitions.sh patched with noatime" || true
    fi
}

# ============================================================
# Phase 2: Memory / sysctl
# ============================================================

do_sysctl() {
    if [ -f /etc/sysctl.conf ]; then
        # Apply sysctl.conf values
        while IFS='=' read -r key val; do
            case "$key" in
                \#*|"") continue ;;
            esac
            key=$(echo "$key" | tr -d ' ')
            val=$(echo "$val" | tr -d ' ')
            PROC_PATH="/proc/sys/$(echo "$key" | tr '.' '/')"
            if [ -w "$PROC_PATH" ]; then
                echo "$val" > "$PROC_PATH" 2>/dev/null
            fi
        done < /etc/sysctl.conf
        echo "optimize: sysctl applied"
    else
        # Fallback: apply critical values directly
        echo 0 > /proc/sys/vm/swappiness 2>/dev/null
        echo 50 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null
        echo 4096 > /proc/sys/vm/min_free_kbytes 2>/dev/null
        echo 10 > /proc/sys/vm/dirty_ratio 2>/dev/null
        echo 5 > /proc/sys/vm/dirty_background_ratio 2>/dev/null
        echo 1 > /proc/sys/vm/overcommit_memory 2>/dev/null
        echo "3 3 3 3" > /proc/sys/kernel/printk 2>/dev/null
        echo 10 > /proc/sys/kernel/panic 2>/dev/null
        echo "optimize: sysctl fallback applied"
    fi
}

# ============================================================
# Phase 2: Storage cleanup (one-time, removes unused binaries)
# ============================================================

do_storage_cleanup() {
    # Only run once — create marker file
    MARKER="/etc/.ee71_cleanup_done"
    if [ -f "$MARKER" ]; then
        return
    fi

    # Bluetooth tools (no Bluetooth hardware)
    for f in btmon hciattach hciconfig hcidump hcitool sdptool; do
        [ -f "/usr/bin/$f" ] && rm -f "/usr/bin/$f" && echo "optimize: removed $f"
    done

    # QMI test/ping utilities (debug only)
    for f in qmi_simple_ril_test qmi_test_service_test qmi_ping_svc qmi_ping_clnt_test_0001 qmi_ping_test; do
        [ -f "/usr/bin/$f" ] && rm -f "/usr/bin/$f" && echo "optimize: removed $f"
    done

    # Audio tools (no audio hardware)
    for f in amix aplay arec; do
        [ -f "/usr/bin/$f" ] && rm -f "/usr/bin/$f" && echo "optimize: removed $f"
    done

    # Keyboard tools (no keyboard)
    for f in dumpkeys loadkeys setfont; do
        [ -f "/usr/bin/$f" ] && rm -f "/usr/bin/$f" && echo "optimize: removed $f"
    done

    # testCne (test binary)
    [ -f "/usr/bin/testCne" ] && rm -f "/usr/bin/testCne" && echo "optimize: removed testCne"

    touch "$MARKER"
    echo "optimize: storage cleanup done"
}

# ============================================================
# Phase 2: Firewall
# ============================================================

do_lan_accept() {
    iptables -C INPUT $LAN_RULE 2>/dev/null || iptables -I INPUT 1 $LAN_RULE
    echo "optimize: bridge0 INPUT ACCEPT"
}

# ============================================================
# Main
# ============================================================

case "$1" in
  start)
    # Called as S11lan_accept (symlink name) — only do firewall rule
    SCRIPT_NAME=$(basename "$0")
    if [ "$SCRIPT_NAME" = "S11lan_accept" ]; then
        do_lan_accept
        exit 0
    fi

    echo "Starting EE71 optimizations..."
    do_disable_init_scripts
    do_misc_daemon_timeout
    do_tmpfs
    do_getty
    do_nbnsd
    do_noatime
    do_sysctl
    do_storage_cleanup
    do_lan_accept
    echo "optimize: all done"
    ;;
  stop)
    iptables -D INPUT $LAN_RULE 2>/dev/null || true
    echo "optimize: bridge0 ACCEPT removed"
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac
exit 0
