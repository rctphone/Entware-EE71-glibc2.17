#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_optimize
# Required-Start:    $remote_fs
# Default-Start:     2 3 4 5
# Short-Description: EE71 performance optimization
### END INIT INFO

# Every-boot optimizations: tmpfs, sysctl, noatime, firewall, CGI cleanup.
# One-time fixes (init scripts, getty, nbnsd, storage) run once via marker file.

MARKER="/etc/.ee71_optimize_done"
LAN_RULE="-i bridge0 -j ACCEPT"

# ============================================================
# One-time fixes (skipped if marker exists)
# ============================================================

do_onetime() {
    [ -f "$MARKER" ] && return

    # Disable init scripts by prefixing DISABLED_ (reversible)
    for script in \
        /etc/rcS.d/S07bootlogd \
        /etc/rc5.d/S20hwclock.sh \
        /etc/rc5.d/S91start_alx_le \
        /etc/rc5.d/S70start_eMBMs_TunnelingModule_le \
        /etc/rc5.d/S90start_subsystem_ramdump \
        /etc/rc5.d/S99stop-bootlogd \
        /etc/rc5.d/S98dbus-1 \
    ; do
        if [ -e "$script" ]; then
            dir=$(dirname "$script")
            base=$(basename "$script")
            [ "${base#DISABLED_}" = "$base" ] && \
                mv "$script" "${dir}/DISABLED_${base}" 2>/dev/null && \
                echo "optimize: disabled $base"
        fi
    done

    # Reduce misc-daemon modem wait timeout from 10s to 3s
    MISC="/etc/init.d/misc-daemon"
    if [ -f "$MISC" ] && grep -q "counter} -le 10" "$MISC" 2>/dev/null; then
        cp -n "$MISC" "${MISC}.old" 2>/dev/null
        sed -i 's/counter} -le 10/counter} -le 3/' "$MISC"
        echo "optimize: misc-daemon timeout 10s → 3s"
    fi

    # Comment out getty in inittab
    if grep -q "^S:.*respawn:/sbin/getty" /etc/inittab 2>/dev/null; then
        cp -n /etc/inittab /etc/inittab.old 2>/dev/null
        sed -i 's|^S:.*respawn:/sbin/getty|#PERF: disabled serial console\n#&|' /etc/inittab
        killall getty 2>/dev/null || true
        echo "optimize: getty disabled"
    fi

    # Rename nbnsd binary to prevent QCMAP from restarting it
    if [ -f /usr/bin/nbnsd ]; then
        mv /usr/bin/nbnsd /usr/bin/nbnsd.disabled
        killall nbnsd 2>/dev/null || true
        echo "optimize: nbnsd disabled"
    fi

    # Patch find_partitions.sh (adds noatime to UBI mounts)
    FP="/etc/init.d/find_partitions.sh"
    if [ -f "$FP" ] && grep -q 'bulk_read"$' "$FP" 2>/dev/null; then
        cp -n "$FP" "${FP}.old" 2>/dev/null
        sed -i 's/bulk_read"/bulk_read,noatime"/' "$FP" 2>/dev/null && \
            echo "optimize: find_partitions.sh patched with noatime"
    fi

    # Install optimized fstab
    if [ -f /etc/fstab.optimized ] && ! grep -q "size=4m" /etc/fstab 2>/dev/null; then
        cp -n /etc/fstab /etc/fstab.old 2>/dev/null
        cp /etc/fstab.optimized /etc/fstab
        echo "optimize: fstab updated"
    fi

    # Storage cleanup: remove unused binaries (~4 MB)
    for f in btmon hciattach hciconfig hcidump hcitool sdptool \
             qmi_simple_ril_test qmi_test_service_test qmi_ping_svc \
             qmi_ping_clnt_test_0001 qmi_ping_test \
             amix aplay arec dumpkeys loadkeys setfont testCne; do
        [ -f "/usr/bin/$f" ] && rm -f "/usr/bin/$f"
    done
    [ -d "/usr/lib/bluez5" ] && rm -rf "/usr/lib/bluez5"
    [ -d "/usr/lib/perl" ] && rm -rf "/usr/lib/perl"
    for f in /usr/tests/dsi_netctrl_test /usr/tests/mcm_data_test; do
        [ -f "$f" ] && rm -f "$f"
    done
    rmdir /usr/tests /usr/games /usr/src 2>/dev/null || true
    [ -f "/usr/sbin/conntrackd" ] && rm -f "/usr/sbin/conntrackd"

    touch "$MARKER"
    echo "optimize: one-time fixes applied"
}

# ============================================================
# Every-boot optimizations
# ============================================================

do_tmpfs() {
    # Right-size tmpfs: stock 203MB reserved → 100MB (actual usage ~200KB)
    mount -o remount,size=4m /run 2>/dev/null || true
    mount -o remount,size=48m /var/volatile 2>/dev/null || true
    mount -o remount,size=48m /media/ram 2>/dev/null || true
    # Clean stale GoAhead CGI temp files
    find /var/volatile/tmp -name 'cgi*' -mmin +60 -delete 2>/dev/null || true
}

do_noatime() {
    mount -o remount,noatime,bulk_read / 2>/dev/null || true
    mount -o remount,noatime,bulk_read /usr 2>/dev/null || true
    mount -o remount,noatime,bulk_read /jrd-resource 2>/dev/null || true
    mount -o remount,noatime,bulk_read /cache 2>/dev/null || true
    mount -o remount,noatime,bulk_read /recovery 2>/dev/null || true
}

do_sysctl() {
    if [ -f /etc/sysctl.conf ]; then
        while IFS='=' read -r key val; do
            case "$key" in \#*|"") continue ;; esac
            key=$(echo "$key" | tr -d ' ')
            val=$(echo "$val" | tr -d ' ')
            PROC_PATH="/proc/sys/$(echo "$key" | tr '.' '/')"
            [ -w "$PROC_PATH" ] && echo "$val" > "$PROC_PATH" 2>/dev/null
        done < /etc/sysctl.conf
    else
        echo 0 > /proc/sys/vm/swappiness 2>/dev/null
        echo 50 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null
        echo 4096 > /proc/sys/vm/min_free_kbytes 2>/dev/null
        echo 10 > /proc/sys/vm/dirty_ratio 2>/dev/null
        echo 5 > /proc/sys/vm/dirty_background_ratio 2>/dev/null
        echo 1 > /proc/sys/vm/overcommit_memory 2>/dev/null
        echo "3 3 3 3" > /proc/sys/kernel/printk 2>/dev/null
        echo 10 > /proc/sys/kernel/panic 2>/dev/null
    fi
}

do_cpu_governor() {
    # core_app calls wifi_improve_tp which sets governor=performance and
    # locks CPU to 1305MHz (doesn't even exist on MDM9640, max is 1190400).
    # Patch the script to use interactive governor with correct freq range.
    TP="/jrd-resource/resource/wlan/shell/wifi_improve_tp"
    if [ -f "$TP" ] && grep -q "^echo performance" "$TP" 2>/dev/null; then
        cat > "$TP" << 'TPEOF'
#!/bin/sh
# WiFi throughput optimization (patched: no performance governor lock)
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
echo 300000 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
echo 1190400 > /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
echo 1048576 > /proc/sys/net/core/rmem_default
echo 1048576 > /proc/sys/net/core/rmem_max
echo 1048576 > /proc/sys/net/core/wmem_default
echo 1048576 > /proc/sys/net/core/wmem_max
echo 0 > /proc/sys/net/ipv4/tcp_timestamps
echo 1 > /proc/sys/net/ipv4/tcp_sack
echo 1 > /proc/sys/net/ipv4/tcp_window_scaling
TPEOF
        echo "optimize: patched wifi_improve_tp (performance → interactive)"
    fi
    # Failsafe: if governor is still performance, fix it now
    GOV="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
    if [ -w "$GOV" ]; then
        CUR=$(cat "$GOV" 2>/dev/null)
        if [ "$CUR" = "performance" ]; then
            echo "interactive" > "$GOV" 2>/dev/null || \
                echo "ondemand" > "$GOV" 2>/dev/null
            echo "optimize: cpu governor $CUR → $(cat "$GOV")"
        fi
    fi
}

do_fix_root_home() {
    # Stock firmware sets root home to /home/root which breaks scp/sftp
    # relative paths. Fix to /root (idempotent — safe to run every boot).
    if grep -q 'root:/home/root:' /etc/passwd 2>/dev/null; then
        mkdir -p /root/.ssh
        cp -an /home/root/.ssh/* /root/.ssh/ 2>/dev/null
        cp -an /home/root/.ash_history /root/ 2>/dev/null
        chmod 700 /root/.ssh
        chmod 600 /root/.ssh/authorized_keys 2>/dev/null
        sed -i 's|root:/home/root:|root:/root:|' /etc/passwd
        echo "optimize: root home /home/root → /root"
    fi
}

do_lan_accept() {
    iptables -C INPUT $LAN_RULE 2>/dev/null || iptables -I INPUT 1 $LAN_RULE
}

# ============================================================
# Main
# ============================================================

case "$1" in
  start)
    # Called as S11lan_accept (symlink) — only firewall rule
    SCRIPT_NAME=$(basename "$0")
    if [ "$SCRIPT_NAME" = "S11lan_accept" ]; then
        do_lan_accept
        exit 0
    fi

    do_onetime
    do_fix_root_home
    do_cpu_governor
    do_tmpfs
    do_noatime
    do_sysctl
    do_lan_accept
    echo "optimize: done"
    ;;
  stop)
    iptables -D INPUT $LAN_RULE 2>/dev/null || true
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac
exit 0
