# /etc/fstab: static file system information — EE71 optimized
rootfs               /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,gid=5       0  0
usbdevfs             /proc/bus/usb        usbdevfs   noauto                0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,size=4m  0  0
tmpfs                /var/volatile        tmpfs      defaults,size=48m     0  0
tmpfs                /media/ram           tmpfs      defaults,size=48m     0  0
/dev/mmcblk0p1       /media/card          auto       defaults,sync,noauto  0  0
