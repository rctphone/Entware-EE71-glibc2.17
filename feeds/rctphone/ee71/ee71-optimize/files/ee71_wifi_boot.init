#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_wifi_boot
# Required-Start:    $remote_fs
# Default-Start:     5
# Short-Description: EE71 re-apply WiFi mode after QCMAP startup
### END INIT INFO

# Runs AFTER QCMAP (S39) to re-apply dual-band via IPC.
# Must run in background so it doesn't block other init scripts.

SCRIPT="/usr/bin/ee71_apply_wifi_boot"

case "$1" in
    start)
        [ -x "$SCRIPT" ] || exit 0
        # Run in background — QCMAP may take 10-30s to be ready, don't block boot
        (nohup "$SCRIPT" >/dev/null 2>&1 &) &
        ;;
    stop)
        # nothing to stop
        ;;
    restart)
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
exit 0
