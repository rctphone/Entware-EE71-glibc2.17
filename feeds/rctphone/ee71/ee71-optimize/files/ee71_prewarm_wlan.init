#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_prewarm_wlan
# Required-Start:    $remote_fs
# Default-Start:     S
# Short-Description: Set WlanMode in XML before QCMAP starts
### END INIT INFO

SCRIPT="/usr/bin/ee71_prewarm_wlan_mode"

case "$1" in
    start)
        [ -x "$SCRIPT" ] || exit 0
        "$SCRIPT"
        ;;
    stop)
        ;;
    restart)
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac
exit 0
