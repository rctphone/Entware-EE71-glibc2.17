#!/bin/sh
### BEGIN INIT INFO
# Provides:          wrtc
# Required-Start:    $remote_fs $networking
# Required-Stop:     $remote_fs
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: Covert WireGuard-over-WebRTC tunnel (EE71, experimental)
### END INIT INFO

BIN=/usr/sbin/ee71-wrtc
CFG=/etc/wrtc/config
PSK=/etc/wrtc/psk
PID_FILE=/var/run/wrtc.pid
LOCAL_PORT=51821

# config: строки KEY=VALUE; обязателен WRTC_URL=wrtc://...
[ -f "$CFG" ] && . "$CFG"

is_running() { [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; }

start() {
    is_running && { echo "wrtc already running (pid $(cat "$PID_FILE"))"; exit 0; }
    [ -x "$BIN" ] || { echo "wrtc: binary not found"; exit 1; }
    [ -n "$WRTC_URL" ] || { echo "wrtc: WRTC_URL not set in $CFG"; exit 1; }
    [ -f "$PSK" ] || { echo "wrtc: PSK file $PSK missing (0600)"; exit 1; }
    # NB: kernel-WireGuard (wg0) поднимается отдельно (wg-quick/wireguard-tools),
    #     peer Endpoint = 127.0.0.1:$LOCAL_PORT (на него смотрит этот joiner).
    "$BIN" -url "$WRTC_URL" -psk-file "$PSK" -local-port "$LOCAL_PORT" >/var/log/wrtc.log 2>&1 &
    echo $! > "$PID_FILE"
    echo "wrtc started (pid $!)"
}

stop() {
    if is_running; then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
        echo "wrtc stopped"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  is_running && echo "running (pid $(cat "$PID_FILE"))" || echo "stopped" ;;
    *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
