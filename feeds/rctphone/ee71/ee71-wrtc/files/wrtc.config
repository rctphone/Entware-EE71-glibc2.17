# ee71-wrtc config — источник для /etc/init.d/wrtc. Заполнить под свой сервер.
#
# Маршрут (БЕЗ секретов) — wrtc:// URL. Спецификация: wrtc-tunnel/docs/URL.md
#   host:port = endpoint WG-сервера; mode = sfu-dc|sfu-video|turn;
#   carrier = jazz|telemost|vk|wbstream; room = pre-created room URL; wgpub = pubkey сервера.
WRTC_URL="wrtc://SERVER:51820?mode=sfu-dc&carrier=jazz&room=ROOMURL&wgpub=SERVERPUB"

# covert AEAD PSK — в ОТДЕЛЬНОМ файле /etc/wrtc/psk, права 0600 (НЕ в URL!).
# Приватный WG-ключ клиента — генерить на устройстве (wg genkey), НЕ переносить.
