# ee71-wrtc config — sourced by /etc/init.d/wrtc. Fill in for your server.
#
# Routing (NO secrets) — wrtc:// URL. Spec: wrtc-tunnel/docs/URL.md
#   host:port = WG server endpoint; mode = sfu-dc|sfu-video|turn;
#   carrier = jazz|telemost|vk|wbstream; room = pre-created room URL; wgpub = server pubkey.
WRTC_URL="wrtc://SERVER:51820?mode=sfu-dc&carrier=jazz&room=ROOMURL&wgpub=SERVERPUB"

# Crypto is WireGuard. Bring up wg0 separately (wg-quick) with peer Endpoint = 127.0.0.1:51821;
# the client WG private key lives in the wg-quick conf (0600), generated on-device (wg genkey).
# This binary carries only the raw WG datagrams — no covert secret here.
