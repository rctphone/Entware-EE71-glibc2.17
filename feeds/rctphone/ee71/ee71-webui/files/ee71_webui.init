#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_webui
# Required-Start:    $remote_fs $syslog $networking
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      1
# Short-Description: EE71 custom web UI daemons (traffic_stats + sms_watchd + speedtest httpd)
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
NAME=ee71_webui
DESC="EE71 Web UI daemons"

TRAFFIC_BIN=/usr/sbin/traffic_stats
TRAFFIC_PID=/var/run/traffic_stats.pid

SMS_BIN=/usr/sbin/sms_watchd
SMS_PID=/var/run/sms_watchd.pid
SMS_CONF=/etc/sms_forward.conf

SPEEDTEST_ROOT=/jrd-resource/speedtest
SPEEDTEST_PID=/var/run/speedtest_httpd.pid
SPEEDTEST_PORT=8877
SPEEDTEST_DOMAIN=ee71.speedtestcustom.com
DNSMASQ_CONF=/etc/dnsmasq.conf

is_running() {
    [ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null
}

start_traffic() {
    if is_running "$TRAFFIC_PID"; then
        echo "traffic_stats already running"
        return 0
    fi
    if [ ! -x "$TRAFFIC_BIN" ]; then
        echo "traffic_stats binary not found"
        return 1
    fi
    # Enable conntrack byte accounting
    echo 1 > /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null
    "$TRAFFIC_BIN"
    echo "traffic_stats started"
}

stop_traffic() {
    if is_running "$TRAFFIC_PID"; then
        kill "$(cat "$TRAFFIC_PID")" 2>/dev/null
        rm -f "$TRAFFIC_PID"
        echo "traffic_stats stopped"
    else
        echo "traffic_stats not running"
    fi
}

start_sms() {
    if is_running "$SMS_PID"; then
        echo "sms_watchd already running"
        return 0
    fi
    if [ ! -x "$SMS_BIN" ]; then
        return 0  # sms_watchd is optional
    fi
    if [ ! -f "$SMS_CONF" ]; then
        return 0  # no config = not enabled
    fi
    # Check if Telegram forwarding is enabled
    ENABLED=$(grep -c '^TELEGRAM_ENABLED=1' "$SMS_CONF" 2>/dev/null || echo 0)
    if [ "$ENABLED" = "0" ]; then
        return 0
    fi
    "$SMS_BIN"
    echo "sms_watchd started"
}

stop_sms() {
    if is_running "$SMS_PID"; then
        kill "$(cat "$SMS_PID")" 2>/dev/null
        rm -f "$SMS_PID"
        echo "sms_watchd stopped"
    fi
}

start_speedtest() {
    if is_running "$SPEEDTEST_PID"; then
        echo "speedtest_httpd already running"
        return 0
    fi
    if [ ! -d "$SPEEDTEST_ROOT" ]; then
        return 0  # speedtest assets not deployed
    fi
    # Get LAN IP
    LAN_IP=$(ifconfig bridge0 2>/dev/null | sed -n 's/.*inet addr:\([^ ]*\).*/\1/p')
    LAN_IP="${LAN_IP:-192.168.1.1}"
    # Ensure dnsmasq resolves our custom domain to the router
    DNS_ENTRY="address=/$SPEEDTEST_DOMAIN/$LAN_IP"
    if ! grep -qF "$SPEEDTEST_DOMAIN" "$DNSMASQ_CONF" 2>/dev/null; then
        echo "$DNS_ENTRY" >> "$DNSMASQ_CONF"
        # SIGHUP does not reload address= records — full restart needed
        DNSMASQ_PID=$(pidof dnsmasq 2>/dev/null)
        if [ -n "$DNSMASQ_PID" ]; then
            DNSMASQ_CMD=$(cat /proc/$DNSMASQ_PID/cmdline 2>/dev/null | tr '\0' ' ')
            kill "$DNSMASQ_PID" 2>/dev/null; sleep 0.3
            $DNSMASQ_CMD 2>/dev/null || true
        fi
        echo "dnsmasq: $SPEEDTEST_DOMAIN -> $LAN_IP"
    fi
    # Open firewall port for speedtest httpd
    iptables -C INPUT -i bridge0 -p tcp --dport "$SPEEDTEST_PORT" -j ACCEPT 2>/dev/null || \
        iptables -I INPUT 1 -i bridge0 -p tcp --dport "$SPEEDTEST_PORT" -j ACCEPT 2>/dev/null
    # Start BusyBox httpd
    busybox httpd -p "${LAN_IP}:${SPEEDTEST_PORT}" -h "$SPEEDTEST_ROOT"
    sleep 0.2
    # Find PID by listening port
    NEW_PID=$(busybox netstat -tlnp 2>/dev/null | sed -n "s/.*${LAN_IP}:${SPEEDTEST_PORT} .* \([0-9]*\)\/.*/\1/p")
    if [ -n "$NEW_PID" ]; then
        echo "$NEW_PID" > "$SPEEDTEST_PID"
        echo "speedtest_httpd started on ${LAN_IP}:${SPEEDTEST_PORT}"
    else
        echo "speedtest_httpd failed to start"
    fi
}

stop_speedtest() {
    if is_running "$SPEEDTEST_PID"; then
        kill "$(cat "$SPEEDTEST_PID")" 2>/dev/null
        rm -f "$SPEEDTEST_PID"
        echo "speedtest_httpd stopped"
    fi
}

case "$1" in
    start)
        echo "Starting $DESC..."
        start_traffic
        start_sms
        start_speedtest
        ;;
    stop)
        echo "Stopping $DESC..."
        stop_traffic
        stop_sms
        stop_speedtest
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if is_running "$TRAFFIC_PID"; then
            echo "traffic_stats: running (pid $(cat "$TRAFFIC_PID"))"
        else
            echo "traffic_stats: stopped"
        fi
        if is_running "$SMS_PID"; then
            echo "sms_watchd: running (pid $(cat "$SMS_PID"))"
        else
            echo "sms_watchd: stopped"
        fi
        if is_running "$SPEEDTEST_PID"; then
            echo "speedtest_httpd: running (pid $(cat "$SPEEDTEST_PID")) on port $SPEEDTEST_PORT"
        else
            echo "speedtest_httpd: stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
