#!/bin/sh
# Inflate the rebuilt wlan.ko into tmpfs and insmod it.
#
# Called from /etc/init.d/wlan in place of the vendor's
#     insmod $MODULE_BASE/extra/wlan.ko $@
# once `/etc/init.d/ee71-wlan-rebuilt enable` has rewritten that line. Module
# parameters (con_mode=5 in FTM mode, otherwise none) arrive as "$@". Exit
# status means what that insmod's meant, and the caller runs it under `set -e`.
#
# Why a script and not just an insmod: /usr has ~3.6 MB free and the module is
# ~3.6 MB, so the rebuilt module cannot sit beside the stock one uncompressed.
# It ships gzipped (~1.3 MB) and is inflated into tmpfs for the moment insmod
# needs to read it.
#
# There is deliberately no fallback to the stock module. If this fails, WiFi
# does not come up - which is recovered over ADB in about thirty seconds
# (`adb shell`, `/etc/init.d/ee71-wlan-rebuilt disable`, reboot). A silent
# fallback would buy nothing for that and would make every experiment lie
# about which driver actually got loaded.

GZ=/usr/lib/ee71/wlan-rebuilt.ko.gz
TMP=/tmp/wlan-rebuilt.ko

# One line in the boot log, so `dmesg | grep wlan_load` answers "which driver
# is this?" without any state file to keep in step.
echo "wlan_load: inserting ${GZ}" > /dev/kmsg 2>/dev/null

if ! gunzip -c "${GZ}" > "${TMP}"; then
	echo "[ERR] wlan_load: cannot inflate ${GZ}" >&2
	rm -f "${TMP}"
	exit 1
fi

insmod "${TMP}" "$@"
rc=$?
rm -f "${TMP}"
exit ${rc}
