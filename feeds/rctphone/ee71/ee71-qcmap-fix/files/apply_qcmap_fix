#!/bin/sh
### BEGIN INIT INFO
# Provides:          apply_qcmap_fix
# Required-Start:    $remote_fs
# Default-Start:     2 3 4 5
# Short-Description: Patch QCMAP_ConnectionManager binary bugs
### END INIT INFO

# Patch 1: 12-byte ARM32 patch at file offset 0x1C4C4 (vaddr 0x244C4)
# Fixes infinite busy loop when netlink attribute has length=0
# Original: sub r2,r2,r4,lsl#3 / add r7,r7,r8 / cmp r2,#2
# Patched:  cmp r8,#0 / subsne r2,r2,r4,lsl#3 / addne r7,r7,r8

# Patch 2: 1-byte patch at file offset 0x6A858
# Disables "rm /var/lib/misc/dnsmasq.leases" — changes 'r' to '#'
# system("#m /var/...") is a shell comment, lease file preserved

QCMAP_BIN="/usr/bin/QCMAP_ConnectionManager"
QCMAP_TMP="/usr/bin/QCMAP_ConnectionManager.tmp"
PATCHED=0

# --- Patch 1: zero-length netlink fix ---
P1_OFFSET=116932  # 0x1C4C4
P1_SIZE=12
P1_ORIG="842142e0087087e0020052e3"
P1_PATCH="000058e38421521008708710"

# --- Patch 2: preserve dnsmasq leases ---
P2_OFFSET=436312  # 0x6A858
P2_SIZE=1
P2_ORIG="72"      # 'r' in "rm /var/..."
P2_PATCH="23"      # '#' — makes it a shell comment

read_hex() {
    local file="$1" offset="$2" size="$3"
    dd if="$file" bs=1 skip="$offset" count="$size" 2>/dev/null | \
        hexdump -v -e "$size/1 \"%02x\"" 2>/dev/null
}

apply_patch() {
    local name="$1" file="$2" offset="$3" size="$4" orig="$5" patch="$6" bytes="$7"

    CURRENT=$(read_hex "$file" "$offset" "$size")

    if [ "$CURRENT" = "$patch" ]; then
        echo "qcmap_fix: $name — already patched"
        return 0
    fi

    if [ "$CURRENT" != "$orig" ]; then
        echo "qcmap_fix: $name — skipped (bytes don't match, binary may differ)"
        return 0
    fi

    printf "$bytes" | dd of="$file" bs=1 seek="$offset" conv=notrunc 2>/dev/null

    VERIFY=$(read_hex "$file" "$offset" "$size")
    if [ "$VERIFY" = "$patch" ]; then
        echo "qcmap_fix: $name — applied"
        PATCHED=1
        return 0
    else
        echo "[ERR] qcmap_fix: $name — verification failed"
        return 1
    fi
}

case "$1" in
  start)
    if [ ! -f "$QCMAP_BIN" ]; then
        echo "[ERR] QCMAP binary not found: $QCMAP_BIN"
        exit 1
    fi

    # Check if all patches already applied
    P1_CUR=$(read_hex "$QCMAP_BIN" "$P1_OFFSET" "$P1_SIZE")
    P2_CUR=$(read_hex "$QCMAP_BIN" "$P2_OFFSET" "$P2_SIZE")

    P1_NEED=0; P2_NEED=0
    [ "$P1_CUR" = "$P1_ORIG" ] && P1_NEED=1
    [ "$P2_CUR" = "$P2_ORIG" ] && P2_NEED=1

    if [ "$P1_NEED" -eq 0 ] && [ "$P2_NEED" -eq 0 ]; then
        echo "qcmap_fix: all patches already applied (or skipped)"
        exit 0
    fi

    # Backup original (once, before any patching)
    if [ ! -f "${QCMAP_BIN}.orig" ]; then
        cp "$QCMAP_BIN" "${QCMAP_BIN}.orig"
        echo "qcmap_fix: backed up original"
    fi

    # Copy binary to work around "Text file busy" on running ELF
    cp "$QCMAP_BIN" "$QCMAP_TMP"

    apply_patch "netlink-fix" "$QCMAP_TMP" \
        "$P1_OFFSET" "$P1_SIZE" "$P1_ORIG" "$P1_PATCH" \
        '\x00\x00\x58\xe3\x84\x21\x52\x10\x08\x70\x87\x10'

    apply_patch "preserve-leases" "$QCMAP_TMP" \
        "$P2_OFFSET" "$P2_SIZE" "$P2_ORIG" "$P2_PATCH" \
        '\x23'

    if [ "$PATCHED" -gt 0 ]; then
        # Replace binary atomically (mv avoids "Text file busy")
        chmod 755 "$QCMAP_TMP"
        mv "$QCMAP_TMP" "$QCMAP_BIN"

        # Restart QCMAP to load patched binary
        PID=$(pidof QCMAP_ConnectionManager 2>/dev/null || true)
        if [ -n "$PID" ]; then
            kill "$PID" 2>/dev/null
            echo "qcmap_fix: QCMAP restarted (was PID $PID)"
        fi
    else
        rm -f "$QCMAP_TMP"
    fi
    ;;
  stop)
    echo "qcmap_fix: no stop action (patches are persistent)"
    ;;
  *)
    echo "Usage: $0 {start|stop}" >&2
    exit 1
    ;;
esac
exit 0
