#!/bin/sh
# Periodic Router Advertisement relay init script
# Needed because carrier only sends RA at PDN setup, radish only proxies.
# Without periodic RAs, WiFi clients lose their default IPv6 route.

PIDFILE=/var/run/send_ra.pid
WAN_IFACE="rmnet_data0"
LAN_IFACE="bridge0"
RA_INTERVAL=600

case "$1" in
    stop)
        if [ -f "$PIDFILE" ]; then
            kill $(cat "$PIDFILE") 2>/dev/null
            rm -f "$PIDFILE"
            echo "send_ra: stopped"
        fi
        ;;
    start|*)
        # Wait for WAN IPv6 (QCMAP needs time to establish PDN)
        sleep 30

        # Check if WAN has global IPv6
        if ! ifconfig "$WAN_IFACE" 2>/dev/null | grep "inet6 addr:" | grep -qv "Scope:Link"; then
            echo "send_ra: no global IPv6 on WAN, not starting"
            exit 0
        fi

        # If send_ra binary exists, use it
        if [ -x /usr/sbin/send_ra ]; then
            /usr/sbin/send_ra -w "$WAN_IFACE" -l "$LAN_IFACE" -i "$RA_INTERVAL" &
            echo $! > "$PIDFILE"
            echo "send_ra: started (PID: $(cat $PIDFILE))"
        else
            echo "send_ra: /usr/sbin/send_ra not found, skipping"
        fi
        ;;
esac
exit 0
