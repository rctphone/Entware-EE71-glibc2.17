--- a/drivers/crypto/msm/qce50.c
+++ b/drivers/crypto/msm/qce50.c
@@ -27,6 +27,15 @@
 #include "qce50.h"
 #include "qcryptohw_50.h"

+/*
+ * Module parameter to override BAM pipe pair from device tree.
+ * Default -1 means use DT value. Valid: 0, 1, 2, 3.
+ * qcedev uses pair 2 (pipes 4-5), qcrypto DT says pair 3 (pipes 6-7).
+ * Pipe pair 3 hangs on EE71 (MDM9640) — try 0 or 1.
+ */
+static int qce_pipe_pair_override = -1;
+module_param(qce_pipe_pair_override, int, 0644);
+MODULE_PARM_DESC(qce_pipe_pair_override, "Override BAM pipe pair index from DT (-1=use DT)");

 #define QCE_SECTOR_SIZE	0x200

