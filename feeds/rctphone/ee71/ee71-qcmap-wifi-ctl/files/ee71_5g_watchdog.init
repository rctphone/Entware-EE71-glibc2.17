#!/bin/sh
### BEGIN INIT INFO
# Provides:          ee71_5g_watchdog
# Required-Start:    $remote_fs
# Default-Start:     5
# Short-Description: EE71 continuous 5GHz (wlan1) hostapd watchdog
### END INIT INFO

# In AP-AP (dual-band) mode wlan1 hostapd can die silently during normal
# operation — the 5GHz network keeps no AP and disappears from the WebUI.
# This launches qcmap_wifi_ctl in watchdog mode, which periodically
# re-checks wlan1 health and restarts it (with anti-flapping backoff),
# so the user never has to press the manual "Repair 5 GHz" button.

BIN="/usr/bin/qcmap_wifi_ctl"
PIDFILE="/var/run/ee71_5g_watchdog.pid"
INTERVAL=45

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

case "$1" in
    start)
        [ -x "$BIN" ] || exit 0
        if is_running; then
            echo "ee71_5g_watchdog already running"
            exit 0
        fi
        "$BIN" watchdog "$INTERVAL" &
        echo $! > "$PIDFILE"
        echo "ee71_5g_watchdog started (interval=${INTERVAL}s)"
        ;;
    stop)
        if is_running; then
            kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
        fi
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        if is_running; then
            echo "running (PID $(cat "$PIDFILE"))"
        else
            echo "stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
exit 0
